SOLR_URL=http://solr:8983
SOLR_COLLECTION=oilStations
CORS_ORIGINS=["http://localhost:4200"]

# Conexión a Postgres (capa de datos dbt, ver EPIC-1). Variables compartidas
# con el servicio postgres/Airflow, sin prefijo (ver ~/.claude/CLAUDE.md).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gasolineras
POSTGRES_PASSWORD=gasolineras
POSTGRES_DB=gasolineras

# Orquestación con Airflow (EPIC-2, ver ADR-2). El backend las usa para
# disparar el DAG gasolineras_ingestion vía la REST API de Airflow. Mismas
# credenciales que _AIRFLOW_WWW_USER_USERNAME/PASSWORD en docker-compose.yml.
# http://localhost:8080 porque este .env es para ejecución fuera de Docker
# (dentro de docker-compose, el backend usa http://airflow:8080, ya fijado
# en docker-compose.yml sin necesidad de .env).
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=admin

# Opcional (ver ADR-3): si se define, el DAG de Airflow notifica los fallos
# del pipeline a este webhook entrante (Discord o Slack). Sin definir, el
# fallo solo queda registrado en los logs de Airflow. La consume el DAG (el
# contenedor `airflow`, no este backend) — hace falta que docker-compose.yml
# la reenvíe también al servicio `airflow` para que surta efecto en Docker.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Si se define, protege POST /api/admin/reindex: hay que mandar esta
# cabecera para poder llamarlo: X-Admin-Token: <valor>
# ADMIN_TOKEN=cambia-esto

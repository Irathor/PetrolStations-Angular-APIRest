# Variables de entorno para docker-compose.yml.
# Copia este archivo a .env y ajusta los valores reales; .env nunca se
# versiona.

# --- Compartidas (postgres / backend / airflow) ---
POSTGRES_USER=gasolineras
POSTGRES_PASSWORD=gasolineras
POSTGRES_DB=gasolineras

# --- Airflow ---
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=admin
# Opcional: URL de webhook para el on_failure_callback del DAG (ver ADR-3).
ALERT_WEBHOOK_URL=

# --- Frontend (Garrus / docker-compose, no leida por el bundler en build) ---
# Puerto de host donde se expone el frontend servido por nginx.
FRONTEND_PORT=4200
